// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Membership {
  GOLD
  SILVER
  JUNIOR
}

enum CourtType {
  CRICKET
  TENNIS
  BADMINTON
  PADEL_COURT
}

enum BookingStatus {
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED
}

// ---------------- USER ----------------

model User {
  id             String              @id @default(uuid())
  name           String
  phone          String              @unique
  email          String              @unique
  membership     Membership
  renewalDate    DateTime?
  pastMembership Membership[]
  lastEntry      DateTime?
  amount         Decimal             @default(0) @db.Decimal(10, 2)
  password       String?
  sportsBookings SportsBooking[]
  cafeOrders     CafeOrder[]
  shopPurchases  SportShopPurchase[]
}

// ---------------- SPORTS BOOKING ----------------

model SportsBooking {
  id                 String        @id @default(uuid())
  userID             String
  whichCourt         CourtType
  slot               DateTime
  endTime            DateTime
  playerCount        Int           @default(1)
  basePrice          Decimal       @db.Decimal(10, 2)
  discountPercentage Decimal       @default(0) @db.Decimal(5, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  status             BookingStatus @default(HELD)
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userID], references: [id])

  @@index([whichCourt, slot, status])
  @@index([userID])
}

// ---------------- SPORT PRICING & CONFIG ----------------

model SportPricing {
  id             String    @id @default(uuid())
  sport          CourtType @unique
  basePrice      Decimal   @db.Decimal(10, 2)
  goldDiscount   Decimal   @default(20) @db.Decimal(5, 2)
  silverDiscount Decimal   @default(10) @db.Decimal(5, 2)
  juniorDiscount Decimal   @default(15) @db.Decimal(5, 2)
  capacity       Int
  openTime       String    @default("06:00")
  closeTime      String    @default("22:00")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------- SLOT FOR CONCURRENCY LOCKING ----------------

model Slot {
  id          String    @id @default(uuid())
  whichCourt  CourtType
  startTime   DateTime
  endTime     DateTime
  maxCapacity Int
  createdAt   DateTime  @default(now())

  @@unique([whichCourt, startTime])
  @@index([whichCourt, startTime])
}

// ---------------- CAFE ----------------

model CafeOrder {
  id          String   @id @default(uuid())
  userID      String
  tableNumber Int?
  orderItems  String[]
  orderNumber String   @unique
  dateTime    DateTime @default(now())
  totalAmount Decimal  @db.Decimal(10, 2)

  user        User     @relation(fields: [userID], references: [id])
}

model CafeMenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------- SPORT SHOP PURCHASE ----------------

model SportShopPurchase {
  id           String   @id @default(uuid())
  userID       String
  name         String
  phone        String
  items        String[]
  purchaseDate DateTime @default(now())
  totalAmount  Decimal  @db.Decimal(10, 2)

  user         User     @relation(fields: [userID], references: [id])
}

// ---------------- PRODUCT / STOCK ----------------

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String
  buyPrice  Decimal  @db.Decimal(10, 2)
  rentPrice Decimal? @db.Decimal(10, 2)
  size      String?
  inStock   Int      @default(0)
}

// ---------------- STAFF ----------------

model Staff {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String
  role        String
  designation String?
  salary      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
}
